<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSymbols>false</IncludeSymbols>
    <PublishSymbols>false</PublishSymbols>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="download.jpg"
                      LogicalName="RBLXHubLauncher.download.jpg" />
    <EmbeddedResource Include="BobloxClassic-nRjl4.ttf"
                      LogicalName="RBLXHubLauncher.BobloxClassic.ttf" />
    <EmbeddedResource Include="Gotham-Medium.otf"
                      LogicalName="RBLXHubLauncher.Gotham-Medium.otf" />
    <EmbeddedResource Include="default-icon.png"
                      LogicalName="RBLXHubLauncher.default-icon.png" />
    <EmbeddedResource Include="icon.ico"
                      LogicalName="RBLXHubLauncher.icon.ico" />
  </ItemGroup>

</Project>
